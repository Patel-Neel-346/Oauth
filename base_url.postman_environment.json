{
  "info": {
    "name": "P2P Loan API Collection",
    "description": "Complete collection for testing P2P Loan platform APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1/loans",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "offerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "loanId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Loan Offers",
      "item": [
        {
          "name": "Create Loan Offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Personal Loan for Students\",\n  \"description\": \"Low interest personal loans for students and young professionals\",\n  \"minAmount\": 5000,\n  \"maxAmount\": 50000,\n  \"interestRate\": 8.5,\n  \"termOptions\": [6, 12, 18, 24],\n  \"loanPurpose\": [\"education\", \"personal\", \"emergency\"],\n  \"eligibilityCriteria\": {\n    \"minCreditScore\": 650,\n    \"maxDebtToIncomeRatio\": 0.4,\n    \"minMonthlyIncome\": 25000\n  },\n  \"totalOffered\": 100000,\n  \"autoApproval\": false,\n  \"expiryDate\": \"2025-12-31T23:59:59.999Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offers",
              "host": ["{{baseUrl}}"],
              "path": ["offers"]
            }
          }
        },
        {
          "name": "Get All Loan Offers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/offers?page=1&limit=10&minAmount=5000&maxAmount=100000&maxInterestRate=10&purpose=personal&term=12",
              "host": ["{{baseUrl}}"],
              "path": ["offers"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "minAmount",
                  "value": "5000"
                },
                {
                  "key": "maxAmount",
                  "value": "100000"
                },
                {
                  "key": "maxInterestRate",
                  "value": "10"
                },
                {
                  "key": "purpose",
                  "value": "personal"
                },
                {
                  "key": "term",
                  "value": "12"
                }
              ]
            }
          }
        },
        {
          "name": "Get Loan Offer Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "{{offerId}}"]
            }
          }
        },
        {
          "name": "Update Loan Offer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Personal Loan Offer\",\n  \"description\": \"Updated description for better terms\",\n  \"interestRate\": 7.5,\n  \"maxAmount\": 75000,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "{{offerId}}"]
            }
          }
        },
        {
          "name": "Get My Loan Offers (Lender)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/my-offers?status=active&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["my-offers"],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Loan Applications",
      "item": [
        {
          "name": "Apply for Loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestedAmount\": 25000,\n  \"selectedTerm\": 12,\n  \"purpose\": \"education\",\n  \"purposeDescription\": \"Need funds for completing my masters degree program\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerId}}/apply",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "{{offerId}}", "apply"]
            }
          }
        },
        {
          "name": "Lender Review Application",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"comments\": \"Good credit profile and stable income. Approved for requested amount.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/lender-review",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "lender-review"]
            }
          }
        },
        {
          "name": "Admin Final Approval",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"comments\": \"All documentation verified. Final approval granted.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/applications/{{applicationId}}/admin-approval",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "{{applicationId}}", "admin-approval"]
            }
          }
        },
        {
          "name": "Get Applications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications?status=pending&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "P2P Loan Management",
      "item": [
        {
          "name": "Disburse Loan (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"APP123456789\",\n  \"borrowerAccountId\": \"ACC987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/disburse",
              "host": ["{{baseUrl}}"],
              "path": ["disburse"]
            }
          }
        },
        {
          "name": "Make Loan Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentAmount\": 2500,\n  \"accountId\": \"ACC987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/payment",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "{{loanId}}", "payment"]
            }
          }
        },
        {
          "name": "Get Loan Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "{{loanId}}"]
            }
          }
        },
        {
          "name": "Get My Loans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/my-loans?type=borrowed&status=active&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["my-loans"],
              "query": [
                {
                  "key": "type",
                  "value": "borrowed",
                  "description": "borrowed | lent | all"
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "active | completed | defaulted | closed"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Lent Loans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/my-loans?type=lent&status=active&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["my-loans"],
              "query": [
                {
                  "key": "type",
                  "value": "lent"
                },
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Loan Payment Schedule",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/schedule",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "{{loanId}}", "schedule"]
            }
          }
        },
        {
          "name": "Get Overdue Loans (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/overdue?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["overdue"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Loan Analytics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["analytics"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// You can add global pre-request scripts here",
          "// For example, to automatically set authentication token"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test scripts",
          "pm.test(\"Status code is successful\", function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
          "});",
          "",
          "pm.test(\"Response has required structure\", function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "});"
        ]
      }
    }
  ]
}