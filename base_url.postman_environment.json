{
  "info": {
    "name": "Stripe Banking API",
    "description": "Complete collection for Stripe payment integration endpoints",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:7000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "account_number",
      "value": "ACC123456789",
      "type": "string"
    },
    {
      "key": "payment_method_id",
      "value": "pm_card_visa",
      "type": "string"
    },
    {
      "key": "payment_intent_id",
      "value": "pi_test_123456",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Payment Methods",
      "item": [
        {
          "name": "Create Payment Method",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"4242424242424242\",\n  \"exp_month\": 12,\n  \"exp_year\": 2025,\n  \"cvc\": \"123\",\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/Stripe/payment-methods",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "payment-methods"]
            },
            "description": "Create a new payment method (credit card) for the authenticated user"
          },
          "response": []
        },
        {
          "name": "Get User Payment Methods",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/Stripe/payment-methods",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "payment-methods"]
            },
            "description": "Retrieve all payment methods for the authenticated user"
          },
          "response": []
        },
        {
          "name": "Delete Payment Method",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/Stripe/payment-methods/{{payment_method_id}}",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "payment-methods", "{{payment_method_id}}"]
            },
            "description": "Delete a specific payment method by ID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payment Processing",
      "item": [
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{account_number}}\",\n  \"amount\": 100.50,\n  \"currency\": \"usd\",\n  \"description\": \"Test payment to savings account\",\n  \"paymentMethodId\": \"{{payment_method_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/Stripe/create-payment-intent",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "create-payment-intent"]
            },
            "description": "Create a payment intent for a specific account"
          },
          "response": []
        },
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{account_number}}\",\n  \"amount\": 250.75,\n  \"currency\": \"usd\",\n  \"description\": \"Direct payment to checking account\",\n  \"paymentMethodId\": \"{{payment_method_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/Stripe/process-payment",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "process-payment"]
            },
            "description": "Process a payment directly to an account"
          },
          "response": []
        },
        {
          "name": "Get Payment Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/Stripe/payment/{{payment_intent_id}}",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "payment", "{{payment_intent_id}}"]
            },
            "description": "Retrieve details of a specific payment by payment intent ID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Refunds",
      "item": [
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentIntentId\": \"{{payment_intent_id}}\",\n  \"amount\": 50.00,\n  \"reason\": \"requested_by_customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/Stripe/refund",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "refund"]
            },
            "description": "Process a refund for a payment. Amount is optional (full refund if not provided)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Transaction History",
      "item": [
        {
          "name": "Get Stripe Payment History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/Stripe/history?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "history"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of records per page"
                },
                {
                  "key": "status",
                  "value": "completed",
                  "description": "Filter by transaction status",
                  "disabled": true
                },
                {
                  "key": "accountNumber",
                  "value": "{{account_number}}",
                  "description": "Filter by specific account number",
                  "disabled": true
                }
              ]
            },
            "description": "Retrieve paginated Stripe payment history for the authenticated user"
          },
          "response": []
        },
        {
          "name": "Get Payment History - Filtered by Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/Stripe/history?page=1&limit=5&status=completed",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "history"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "status",
                  "value": "completed"
                }
              ]
            },
            "description": "Get payment history filtered by transaction status"
          },
          "response": []
        },
        {
          "name": "Get Payment History - Filtered by Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/Stripe/history?page=1&limit=10&accountNumber={{account_number}}",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "history"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "accountNumber",
                  "value": "{{account_number}}"
                }
              ]
            },
            "description": "Get payment history for a specific account"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Stripe Webhook Handler",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "stripe-signature",
                "value": "t=1234567890,v1=signature_here",
                "description": "Stripe webhook signature"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_webhook\",\n  \"object\": \"event\",\n  \"api_version\": \"2020-08-27\",\n  \"created\": 1234567890,\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_test_123456\",\n      \"object\": \"payment_intent\",\n      \"amount\": 10000,\n      \"currency\": \"usd\",\n      \"status\": \"succeeded\"\n    }\n  },\n  \"livemode\": false,\n  \"pending_webhooks\": 1,\n  \"request\": {\n    \"id\": \"req_test_123456\",\n    \"idempotency_key\": null\n  },\n  \"type\": \"payment_intent.succeeded\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/Stripe/webhook",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "webhook"]
            },
            "description": "Webhook endpoint for Stripe events (payment_intent.succeeded, payment_intent.payment_failed, etc.)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Test Card Examples",
      "item": [
        {
          "name": "Create Payment Method - Visa Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"4242424242424242\",\n  \"exp_month\": 12,\n  \"exp_year\": 2025,\n  \"cvc\": \"123\",\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/Stripe/payment-methods",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "payment-methods"]
            },
            "description": "Test with Visa card that will succeed"
          },
          "response": []
        },
        {
          "name": "Create Payment Method - Card Declined",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"4000000000000002\",\n  \"exp_month\": 12,\n  \"exp_year\": 2025,\n  \"cvc\": \"123\",\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/Stripe/payment-methods",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "payment-methods"]
            },
            "description": "Test with card that will be declined"
          },
          "response": []
        },
        {
          "name": "Create Payment Method - Insufficient Funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"4000000000009995\",\n  \"exp_month\": 12,\n  \"exp_year\": 2025,\n  \"cvc\": \"123\",\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/Stripe/payment-methods",
              "host": ["{{base_url}}"],
              "path": ["Stripe", "payment-methods"]
            },
            "description": "Test with card that will have insufficient funds"
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// You can add pre-request scripts here",
          "// For example, to automatically set timestamps or generate test data",
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test scripts",
          "pm.test(\"Status code is successful\", function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "pm.test(\"Response has success property\", function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "});"
        ]
      }
    }
  ]
}