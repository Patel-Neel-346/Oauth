{
  "info": {
    "name": "Loan Management API",
    "description": "API collection for P2P Loan Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Loan Offers",
      "item": [
        {
          "name": "Create Loan Offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Personal Loan Offer\",\n  \"description\": \"Competitive personal loan with flexible terms\",\n  \"minAmount\": 10000,\n  \"maxAmount\": 500000,\n  \"interestRate\": 12.5,\n  \"termOptions\": [12, 24, 36, 48, 60],\n  \"loanPurpose\": [\"personal\", \"education\", \"vehicle\"],\n  \"eligibilityCriteria\": {\n    \"minCreditScore\": 650,\n    \"maxDebtToIncomeRatio\": 0.4,\n    \"minMonthlyIncome\": 30000,\n    \"employmentStatus\": [\"employed\", \"self-employed\"],\n    \"minEmploymentDuration\": 12\n  },\n  \"totalOffered\": 2000000,\n  \"autoApproval\": false,\n  \"expiryDate\": \"2024-12-31T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loan/offers",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "offers"]
            }
          }
        },
        {
          "name": "Get All Loan Offers",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/loan/offers?page=1&limit=10&minAmount=10000&maxAmount=500000&maxInterestRate=15&purpose=personal&term=24",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "offers"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "minAmount",
                  "value": "10000"
                },
                {
                  "key": "maxAmount",
                  "value": "500000"
                },
                {
                  "key": "maxInterestRate",
                  "value": "15"
                },
                {
                  "key": "purpose",
                  "value": "personal"
                },
                {
                  "key": "term",
                  "value": "24"
                }
              ]
            }
          }
        },
        {
          "name": "Get Loan Offer Details",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/loan/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "offers", "{{offerId}}"],
              "variable": [
                {
                  "key": "offerId",
                  "value": "LOAN_OFFER_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Update Loan Offer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Personal Loan Offer\",\n  \"description\": \"Updated competitive personal loan with flexible terms\",\n  \"interestRate\": 11.5,\n  \"status\": \"active\",\n  \"autoApproval\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loan/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "offers", "{{offerId}}"],
              "variable": [
                {
                  "key": "offerId",
                  "value": "LOAN_OFFER_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Loan Offers (Lender)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/loan/my-offers?page=1&limit=10&status=active",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "my-offers"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Loan Applications",
      "item": [
        {
          "name": "Apply for Loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestedAmount\": 100000,\n  \"selectedTerm\": 24,\n  \"purpose\": \"personal\",\n  \"purposeDescription\": \"Home renovation and personal expenses\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loan/offers/{{offerId}}/apply",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "offers", "{{offerId}}", "apply"],
              "variable": [
                {
                  "key": "offerId",
                  "value": "LOAN_OFFER_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Lender Review Application",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"comments\": \"Application meets all criteria. Approved for processing.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loan/applications/{{applicationId}}/lender-review",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "applications", "{{applicationId}}", "lender-review"],
              "variable": [
                {
                  "key": "applicationId",
                  "value": "APPLICATION_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Admin Final Approval",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approved\",\n  \"comments\": \"Final approval granted. Loan ready for disbursement.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loan/applications/{{applicationId}}/admin-approval",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "applications", "{{applicationId}}", "admin-approval"],
              "variable": [
                {
                  "key": "applicationId",
                  "value": "APPLICATION_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Get Applications",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/loan/applications?page=1&limit=10&status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["loan", "applications"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.accessToken) {",
                  "        pm.collectionVariables.set('authToken', jsonData.data.accessToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    }
  ]
}