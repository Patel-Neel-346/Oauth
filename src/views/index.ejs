<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bank Transactions</title>
    <script src="https://js.stripe.com/v3/"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1><i class="fas fa-university"></i> Bank Transactions</h1>
        <p>Manage your deposits, withdrawals, and transfers securely</p>
      </div>

      <div class="tabs">
        <button class="tab active" onclick="showTab('deposit')">
          <i class="fas fa-plus-circle"></i> Deposit
        </button>
        <button class="tab" onclick="showTab('withdraw')">
          <i class="fas fa-minus-circle"></i> Withdraw
        </button>
        <button class="tab" onclick="showTab('transfer')">
          <i class="fas fa-exchange-alt"></i> Transfer
        </button>
        <button class="tab" onclick="showTab('history')">
          <i class="fas fa-history"></i> History
        </button>
      </div>

      <div class="content">
        <div id="alerts"></div>

        <!-- Deposit Tab -->
        <div id="deposit" class="tab-content active">
          <h2><i class="fas fa-plus-circle"></i> Deposit Funds</h2>

          <form id="depositForm">
            <div class="row">
              <div class="form-group">
                <label>Account Number</label>
                <input
                  type="text"
                  id="depositAccountNumber"
                  class="form-control"
                  placeholder="123-456-7890"
                  required
                />
              </div>
              <div class="form-group">
                <label>Amount ($)</label>
                <input
                  type="number"
                  id="depositAmount"
                  class="form-control"
                  step="0.01"
                  min="1"
                  placeholder="100.00"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="depositDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <div class="form-group">
              <label>Deposit Method</label>
              <select
                id="depositMethod"
                class="form-control"
                onchange="toggleDepositMethod()"
              >
                <option value="cash">Cash/Check Deposit</option>
                <option value="stripe">Credit/Debit Card (Stripe)</option>
              </select>
            </div>

            <!-- Cash Deposit -->
            <div id="cashDeposit">
              <button
                type="button"
                class="btn btn-success"
                onclick="processCashDeposit()"
                id="cashDepositBtn"
              >
                <i class="fas fa-money-bill-wave"></i>
                <span>Process Cash Deposit</span>
                <div class="spinner" id="cashSpinner"></div>
              </button>
            </div>

            <!-- Stripe Deposit -->
            <div id="stripeDeposit" style="display: none">
              <div class="stripe-form">
                <h3><i class="fab fa-stripe"></i> Card Payment Details</h3>

                <div class="row">
                  <div class="form-group">
                    <label>Cardholder Name</label>
                    <input
                      type="text"
                      id="cardholderName"
                      class="form-control"
                      placeholder="John Doe"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <label>Email</label>
                    <input
                      type="email"
                      id="cardholderEmail"
                      class="form-control"
                      placeholder="john@example.com"
                      required
                    />
                  </div>
                </div>

                <div class="form-group">
                  <label>Phone</label>
                  <input
                    type="tel"
                    id="cardholderPhone"
                    class="form-control"
                    placeholder="(123) 456-7890"
                  />
                </div>

                <div class="form-group">
                  <label>Card Information</label>
                  <div
                    id="stripe-card-element"
                    class="stripe-card-element"
                  ></div>
                  <div
                    id="card-errors"
                    role="alert"
                    style="color: #721c24; margin-top: 10px"
                  ></div>
                </div>

                <button
                  type="button"
                  class="btn btn-primary"
                  onclick="processStripeDeposit()"
                  id="stripeDepositBtn"
                >
                  <i class="fab fa-stripe-s"></i>
                  <span>Pay with Stripe</span>
                  <div class="spinner" id="stripeSpinner"></div>
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- Withdraw Tab -->
        <div id="withdraw" class="tab-content">
          <h2><i class="fas fa-minus-circle"></i> Withdraw Funds</h2>

          <form id="withdrawForm">
            <div class="row">
              <div class="form-group">
                <label>Account Number</label>
                <input
                  type="text"
                  id="withdrawAccountNumber"
                  class="form-control"
                  placeholder="123-456-7890"
                  required
                />
              </div>
              <div class="form-group">
                <label>Amount ($)</label>
                <input
                  type="number"
                  id="withdrawAmount"
                  class="form-control"
                  step="0.01"
                  min="1"
                  placeholder="100.00"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="withdrawDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <button
              type="button"
              class="btn btn-warning"
              onclick="processWithdraw()"
              id="withdrawBtn"
            >
              <i class="fas fa-money-bill-wave"></i>
              <span>Process Withdrawal</span>
              <div class="spinner" id="withdrawSpinner"></div>
            </button>
          </form>
        </div>

        <!-- Transfer Tab -->
        <div id="transfer" class="tab-content">
          <h2><i class="fas fa-exchange-alt"></i> Transfer Funds</h2>

          <form id="transferForm">
            <div class="row">
              <div class="form-group">
                <label>From Account Number</label>
                <input
                  type="text"
                  id="fromAccountNumber"
                  class="form-control"
                  placeholder="123-456-7890"
                  required
                />
              </div>
              <div class="form-group">
                <label>To Account Number</label>
                <input
                  type="text"
                  id="toAccountNumber"
                  class="form-control"
                  placeholder="987-654-3210"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Amount ($)</label>
              <input
                type="number"
                id="transferAmount"
                class="form-control"
                step="0.01"
                min="1"
                placeholder="100.00"
                required
              />
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="transferDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <div class="form-group">
              <label>Transfer Method</label>
              <select
                id="transferMethod"
                class="form-control"
                onchange="toggleTransferMethod()"
              >
                <option value="regular">Regular Transfer</option>
                <option value="stripe">
                  Stripe Transfer (with card funding)
                </option>
              </select>
            </div>

            <!-- Regular Transfer -->
            <div id="regularTransfer">
              <div class="form-group">
                <label>Transfer Type</label>
                <select id="transferType" class="form-control">
                  <option value="instant">Instant Transfer</option>
                  <option value="standard">Standard Transfer</option>
                </select>
              </div>

              <button
                type="button"
                class="btn btn-primary"
                onclick="processTransfer()"
                id="transferBtn"
              >
                <i class="fas fa-exchange-alt"></i>
                <span>Process Transfer</span>
                <div class="spinner" id="transferSpinner"></div>
              </button>
            </div>

            <!-- Stripe Transfer -->
            <div id="stripeTransfer" style="display: none">
              <div class="form-group">
                <label>Transfer Type</label>
                <select id="stripeTransferType" class="form-control">
                  <option value="instant">Instant Transfer</option>
                  <option value="standard">Standard Transfer</option>
                </select>
              </div>

              <div class="stripe-form">
                <h3><i class="fab fa-stripe"></i> Card Details for Funding</h3>
                <p>
                  <small>
                    Card will be used to fund the transfer if account balance is
                    insufficient
                  </small>
                </p>

                <div class="row">
                  <div class="form-group">
                    <label>Cardholder Name</label>
                    <input
                      type="text"
                      id="transferCardholderName"
                      class="form-control"
                      placeholder="John Doe"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <label>Email</label>
                    <input
                      type="email"
                      id="transferCardholderEmail"
                      class="form-control"
                      placeholder="john@example.com"
                      required
                    />
                  </div>
                </div>

                <div class="form-group">
                  <label>Phone</label>
                  <input
                    type="tel"
                    id="transferCardholderPhone"
                    class="form-control"
                    placeholder="(123) 456-7890"
                  />
                </div>

                <div class="form-group">
                  <label>Card Information</label>
                  <div
                    id="stripe-transfer-card-element"
                    class="stripe-card-element"
                  ></div>
                  <div
                    id="transfer-card-errors"
                    role="alert"
                    style="color: #721c24; margin-top: 10px"
                  ></div>
                </div>

                <button
                  type="button"
                  class="btn btn-primary"
                  onclick="processStripeTransfer()"
                  id="stripeTransferBtn"
                >
                  <i class="fab fa-stripe-s"></i>
                  <span>Process Stripe Transfer</span>
                  <div class="spinner" id="stripeTransferSpinner"></div>
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- History Tab -->
        <div id="history" class="tab-content">
          <h2><i class="fas fa-history"></i> Transaction History</h2>

          <div class="transaction-list" id="transactionList">
            <div class="transaction-item">
              <div>
                <strong>Deposit</strong> - $500.00
                <br />
                <small>2023-10-15 14:30:25</small>
                <br />
                Initial account funding
              </div>
              <span class="transaction-type type-deposit">Deposit</span>
            </div>

            <div class="transaction-item">
              <div>
                <strong>Withdrawal</strong> - $150.00
                <br />
                <small>2023-10-18 09:15:42</small>
                <br />
                ATM withdrawal
              </div>
              <span class="transaction-type type-withdraw">Withdrawal</span>
            </div>

            <div class="transaction-item">
              <div>
                <strong>Transfer</strong> - $200.00
                <br />
                <small>2023-10-20 11:45:18</small>
                <br />
                To savings account
              </div>
              <span class="transaction-type type-transfer">Transfer</span>
            </div>

            <div class="transaction-item">
              <div>
                <strong>Deposit</strong> - $1,200.00
                <br />
                <small>2023-10-25 16:20:33</small>
                <br />
                Salary deposit
              </div>
              <span class="transaction-type type-deposit">Deposit</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Configuration
      const API_BASE_URL = window.location.origin;
      const STRIPE_PUBLIC_KEY =
        "pk_test_51QfQyYCQkunRa8JYtiDumB6BMWjOwqrYMnp3p14rxHepDcSWALJKrKGp4immlWPAbejkuzGgoJbsIApu8WEbgv0Z00NwDBA5XT";

      // Stripe variables
      let stripe, elements, card, transferCard;

      // Utility functions
      function showAlert(message, type = "success") {
        const alertsContainer = document.getElementById("alerts");
        const alertDiv = document.createElement("div");
        alertDiv.className = `alert alert-${type} show`;
        alertDiv.innerHTML = `
        ${message}
        <button onclick="this.parentElement.remove()">&times;</button>
      `;
        alertsContainer.appendChild(alertDiv);

        setTimeout(() => {
          alertDiv.remove();
        }, 5000);
      }

      function setLoading(buttonId, spinnerId, isLoading) {
        const button = document.getElementById(buttonId);
        const spinner = document.getElementById(spinnerId);

        if (isLoading) {
          button.disabled = true;
          spinner.style.display = "inline-block";
        } else {
          button.disabled = false;
          spinner.style.display = "none";
        }
      }

      function getAuthToken() {
        // In a real app, get token from localStorage or sessionStorage
        return "user_auth_token";
      }

      // Tab functionality
      function showTab(id) {
        const tabs = document.querySelectorAll(".tab");
        const contents = document.querySelectorAll(".tab-content");

        tabs.forEach((tab) => tab.classList.remove("active"));
        contents.forEach((content) => content.classList.remove("active"));

        document.querySelector(`#${id}`).classList.add("active");
        event.currentTarget.classList.add("active");

        // Reinitialize Stripe elements when switching to transfer tab
        if (id === "transfer") {
          setTimeout(() => {
            if (
              document.getElementById("stripeTransfer").style.display ===
              "block"
            ) {
              initializeStripeCard("transfer");
            }
          }, 100);
        }
      }

      function toggleDepositMethod() {
        const method = document.getElementById("depositMethod").value;
        document.getElementById("cashDeposit").style.display =
          method === "cash" ? "block" : "none";
        document.getElementById("stripeDeposit").style.display =
          method === "stripe" ? "block" : "none";

        // Initialize stripe card when method is selected
        if (method === "stripe") {
          setTimeout(() => {
            initializeStripeCard("deposit");
          }, 100);
        }
      }

      function toggleTransferMethod() {
        const method = document.getElementById("transferMethod").value;
        document.getElementById("regularTransfer").style.display =
          method === "regular" ? "block" : "none";
        document.getElementById("stripeTransfer").style.display =
          method === "stripe" ? "block" : "none";

        // Initialize stripe card when method is selected
        if (method === "stripe") {
          setTimeout(() => {
            initializeStripeCard("transfer");
          }, 100);
        }
      }

      // Initialize Stripe card elements on demand
      function initializeStripeCard(type) {
        try {
          if (!stripe) {
            stripe = Stripe(STRIPE_PUBLIC_KEY);
            elements = stripe.elements();
          }

          if (type === "deposit" && !card) {
            // Initialize deposit card
            card = elements.create("card", {
              style: {
                base: {
                  fontSize: "16px",
                  color: "#32325d",
                  "::placeholder": {
                    color: "#aab7c4",
                  },
                },
              },
            });

            card.mount("#stripe-card-element");

            card.on("change", ({ error }) => {
              const displayError = document.getElementById("card-errors");
              if (error) {
                displayError.textContent = error.message;
              } else {
                displayError.textContent = "";
              }
            });
          }

          if (type === "transfer" && !transferCard) {
            // Initialize transfer card
            transferCard = elements.create("card", {
              style: {
                base: {
                  fontSize: "16px",
                  color: "#32325d",
                  "::placeholder": {
                    color: "#aab7c4",
                  },
                },
              },
            });

            transferCard.mount("#stripe-transfer-card-element");

            transferCard.on("change", ({ error }) => {
              const displayError = document.getElementById(
                "transfer-card-errors"
              );
              if (error) {
                displayError.textContent = error.message;
              } else {
                displayError.textContent = "";
              }
            });
          }

          // Update the card elements after mounting
          setTimeout(() => {
            if (type === "deposit" && card) {
              card.update();
            }
            if (type === "transfer" && transferCard) {
              transferCard.update();
            }
          }, 300);
        } catch (error) {
          console.error("Stripe card initialization failed:", error);
          showAlert(
            "Failed to initialize card form. Please refresh the page.",
            "error"
          );
        }
      }

      // Transaction processing functions (simulated)
      function processCashDeposit() {
        const accountNumber = document.getElementById(
          "depositAccountNumber"
        ).value;
        const amount = parseFloat(
          document.getElementById("depositAmount").value
        );

        if (!accountNumber || !amount || amount <= 0) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        setLoading("cashDepositBtn", "cashSpinner", true);

        setTimeout(() => {
          showAlert(
            `Cash deposit of $${amount.toFixed(
              2
            )} to account ${accountNumber} was successful!`,
            "success"
          );
          document.getElementById("depositForm").reset();
          setLoading("cashDepositBtn", "cashSpinner", false);
        }, 1500);
      }

      function processWithdraw() {
        const accountNumber = document.getElementById(
          "withdrawAccountNumber"
        ).value;
        const amount = parseFloat(
          document.getElementById("withdrawAmount").value
        );

        if (!accountNumber || !amount || amount <= 0) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        setLoading("withdrawBtn", "withdrawSpinner", true);

        setTimeout(() => {
          showAlert(
            `Withdrawal of $${amount.toFixed(
              2
            )} from account ${accountNumber} was successful!`,
            "success"
          );
          document.getElementById("withdrawForm").reset();
          setLoading("withdrawBtn", "withdrawSpinner", false);
        }, 1500);
      }

      function processTransfer() {
        const fromAccount = document.getElementById("fromAccountNumber").value;
        const toAccount = document.getElementById("toAccountNumber").value;
        const amount = parseFloat(
          document.getElementById("transferAmount").value
        );

        if (!fromAccount || !toAccount || !amount || amount <= 0) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        if (fromAccount === toAccount) {
          showAlert(
            "Source and destination accounts cannot be the same.",
            "error"
          );
          return;
        }

        setLoading("transferBtn", "transferSpinner", true);

        setTimeout(() => {
          showAlert(
            `Transfer of $${amount.toFixed(
              2
            )} from ${fromAccount} to ${toAccount} was successful!`,
            "success"
          );
          document.getElementById("transferForm").reset();
          setLoading("transferBtn", "transferSpinner", false);
        }, 1500);
      }

      function processStripeDeposit() {
        const accountNumber = document.getElementById(
          "depositAccountNumber"
        ).value;
        const amount = parseFloat(
          document.getElementById("depositAmount").value
        );
        const name = document.getElementById("cardholderName").value;

        if (!accountNumber || !amount || amount <= 0 || !name) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        if (!card) {
          showAlert("Card form not initialized. Please try again.", "error");
          return;
        }

        setLoading("stripeDepositBtn", "stripeSpinner", true);

        setTimeout(() => {
          showAlert(
            `Stripe deposit of $${amount.toFixed(
              2
            )} to account ${accountNumber} was successful!`,
            "success"
          );
          document.getElementById("depositForm").reset();
          if (card) card.clear();
          setLoading("stripeDepositBtn", "stripeSpinner", false);
        }, 2000);
      }

      function processStripeTransfer() {
        const fromAccount = document.getElementById("fromAccountNumber").value;
        const toAccount = document.getElementById("toAccountNumber").value;
        const amount = parseFloat(
          document.getElementById("transferAmount").value
        );
        const name = document.getElementById("transferCardholderName").value;

        if (!fromAccount || !toAccount || !amount || amount <= 0 || !name) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        if (!transferCard) {
          showAlert("Card form not initialized. Please try again.", "error");
          return;
        }

        setLoading("stripeTransferBtn", "stripeTransferSpinner", true);

        setTimeout(() => {
          showAlert(
            `Stripe transfer of $${amount.toFixed(
              2
            )} from ${fromAccount} to ${toAccount} was successful!`,
            "success"
          );
          document.getElementById("transferForm").reset();
          if (transferCard) transferCard.clear();
          setLoading("stripeTransferBtn", "stripeTransferSpinner", false);
        }, 2000);
      }

      // Initialize the page
      document.addEventListener("DOMContentLoaded", function () {
        console.log("Bank Transactions page loaded");

        // Initialize the deposit tab as active
        toggleDepositMethod();
      });
    </script>
  </body>
</html>
