<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bank Transactions</title>
    <script src="https://js.stripe.com/v3/"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1><i class="fas fa-university"></i> Bank Transactions</h1>
        <p>Manage your deposits, withdrawals, and transfers securely</p>
      </div>

      <div class="tabs">
        <button class="tab active" onclick="showTab('deposit')">
          <i class="fas fa-plus-circle"></i> Deposit
        </button>
        <button class="tab" onclick="showTab('withdraw')">
          <i class="fas fa-minus-circle"></i> Withdraw
        </button>
        <button class="tab" onclick="showTab('transfer')">
          <i class="fas fa-exchange-alt"></i> Transfer
        </button>
        <button class="tab" onclick="showTab('history')">
          <i class="fas fa-history"></i> History
        </button>
      </div>

      <div class="content">
        <div id="alerts"></div>

        <!-- Deposit Tab -->
        <div id="deposit" class="tab-content active">
          <h2><i class="fas fa-plus-circle"></i> Deposit Funds</h2>

          <form id="depositForm">
            <div class="row">
              <div class="form-group">
                <label>Account Number</label>
                <input
                  type="text"
                  id="depositAccountNumber"
                  class="form-control"
                  required
                />
              </div>
              <div class="form-group">
                <label>Amount ($)</label>
                <input
                  type="number"
                  id="depositAmount"
                  class="form-control"
                  step="0.01"
                  min="1"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="depositDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <div class="form-group">
              <label>Deposit Method</label>
              <select
                id="depositMethod"
                class="form-control"
                onchange="toggleDepositMethod()"
              >
                <option value="cash">Cash/Check Deposit</option>
                <option value="stripe">Credit/Debit Card (Stripe)</option>
              </select>
            </div>

            <!-- Cash Deposit -->
            <div id="cashDeposit">
              <button
                type="button"
                class="btn btn-success"
                onclick="processCashDeposit()"
                id="cashDepositBtn"
              >
                <i class="fas fa-money-bill-wave"></i>
                <span>Process Cash Deposit</span>
                <div class="spinner" id="cashSpinner"></div>
              </button>
            </div>

            <!-- Stripe Deposit -->
            <div id="stripeDeposit" style="display: none">
              <div class="stripe-form">
                <h3><i class="fab fa-stripe"></i> Card Payment Details</h3>

                <div class="row">
                  <div class="form-group">
                    <label>Cardholder Name</label>
                    <input
                      type="text"
                      id="cardholderName"
                      class="form-control"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <label>Email</label>
                    <input
                      type="email"
                      id="cardholderEmail"
                      class="form-control"
                      required
                    />
                  </div>
                </div>

                <div class="form-group">
                  <label>Phone</label>
                  <input type="tel" id="cardholderPhone" class="form-control" />
                </div>

                <div class="form-group">
                  <label>Card Information</label>
                  <div id="stripe-card-element"></div>
                  <div
                    id="card-errors"
                    role="alert"
                    style="color: #721c24; margin-top: 10px"
                  ></div>
                </div>

                <button
                  type="button"
                  class="btn btn-primary"
                  onclick="processStripeDeposit()"
                  id="stripeDepositBtn"
                >
                  <i class="fab fa-stripe-s"></i>
                  <span>Pay with Stripe</span>
                  <div class="spinner" id="stripeSpinner"></div>
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- Withdraw Tab -->
        <div id="withdraw" class="tab-content">
          <h2><i class="fas fa-minus-circle"></i> Withdraw Funds</h2>

          <form id="withdrawForm">
            <div class="row">
              <div class="form-group">
                <label>Account Number</label>
                <input
                  type="text"
                  id="withdrawAccountNumber"
                  class="form-control"
                  required
                />
              </div>
              <div class="form-group">
                <label>Amount ($)</label>
                <input
                  type="number"
                  id="withdrawAmount"
                  class="form-control"
                  step="0.01"
                  min="1"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="withdrawDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <button
              type="button"
              class="btn btn-warning"
              onclick="processWithdraw()"
              id="withdrawBtn"
            >
              <i class="fas fa-money-bill-wave"></i>
              <span>Process Withdrawal</span>
              <div class="spinner" id="withdrawSpinner"></div>
            </button>
          </form>
        </div>

        <!-- Transfer Tab -->
        <div id="transfer" class="tab-content">
          <h2><i class="fas fa-exchange-alt"></i> Transfer Funds</h2>

          <form id="transferForm">
            <div class="row">
              <div class="form-group">
                <label>From Account Number</label>
                <input
                  type="text"
                  id="fromAccountNumber"
                  class="form-control"
                  required
                />
              </div>
              <div class="form-group">
                <label>To Account Number</label>
                <input
                  type="text"
                  id="toAccountNumber"
                  class="form-control"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Amount ($)</label>
              <input
                type="number"
                id="transferAmount"
                class="form-control"
                step="0.01"
                min="1"
                required
              />
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="transferDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <div class="form-group">
              <label>Transfer Method</label>
              <select
                id="transferMethod"
                class="form-control"
                onchange="toggleTransferMethod()"
              >
                <option value="regular">Regular Transfer</option>
                <option value="stripe">
                  Stripe Transfer (with card funding)
                </option>
              </select>
            </div>

            <!-- Regular Transfer -->
            <div id="regularTransfer">
              <div class="form-group">
                <label>Transfer Type</label>
                <select id="transferType" class="form-control">
                  <option value="instant">Instant Transfer</option>
                  <option value="standard">Standard Transfer</option>
                </select>
              </div>

              <button
                type="button"
                class="btn btn-primary"
                onclick="processTransfer()"
                id="transferBtn"
              >
                <i class="fas fa-exchange-alt"></i>
                <span>Process Transfer</span>
                <div class="spinner" id="transferSpinner"></div>
              </button>
            </div>

            <!-- Stripe Transfer -->
            <div id="stripeTransfer" style="display: none">
              <div class="form-group">
                <label>Transfer Type</label>
                <select id="stripeTransferType" class="form-control">
                  <option value="instant">Instant Transfer</option>
                  <option value="standard">Standard Transfer</option>
                </select>
              </div>

              <div class="stripe-form">
                <h3><i class="fab fa-stripe"></i> Card Details for Funding</h3>
                <p>
                  <small
                    >Card will be used to fund the transfer if account balance
                    is insufficient</small
                  >
                </p>

                <div class="row">
                  <div class="form-group">
                    <label>Cardholder Name</label>
                    <input
                      type="text"
                      id="transferCardholderName"
                      class="form-control"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <label>Email</label>
                    <input
                      type="email"
                      id="transferCardholderEmail"
                      class="form-control"
                      required
                    />
                  </div>
                </div>

                <div class="form-group">
                  <label>Phone</label>
                  <input
                    type="tel"
                    id="transferCardholderPhone"
                    class="form-control"
                  />
                </div>

                <div class="form-group">
                  <label>Card Information</label>
                  <div id="stripe-transfer-card-element"></div>
                  <div
                    id="transfer-card-errors"
                    role="alert"
                    style="color: #721c24; margin-top: 10px"
                  ></div>
                </div>

                <button
                  type="button"
                  class="btn btn-primary"
                  onclick="processStripeTransfer()"
                  id="stripeTransferBtn"
                >
                  <i class="fab fa-stripe-s"></i>
                  <span>Process Stripe Transfer</span>
                  <div class="spinner" id="stripeTransferSpinner"></div>
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- History Tab -->
        <div id="history" class="tab-content">
          <h2><i class="fas fa-history"></i> Transaction History</h2>

          <div class="transaction-list" id="transactionList">
            <% if (transactions && transactions.length > 0) { %> <%
            transactions.forEach(transaction => { %>
            <div class="transaction-item">
              <div>
                <strong><%= transaction.type %></strong> - $<%=
                transaction.amount %>
                <br />
                <small><%= transaction.date %></small>
                <br />
                <%= transaction.description %>
              </div>
              <span
                class="transaction-type type-<%= transaction.type.toLowerCase() %>"
              >
                <%= transaction.type %>
              </span>
            </div>
            <% }) %> <% } else { %>
            <p>No transactions found.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Configuration - these should come from your backend
      const API_BASE_URL = window.location.origin; // Adjust this to your API base URL
      const STRIPE_PUBLIC_KEY =
        "pk_test_51QfQyYCQkunRa8JYtiDumB6BMWjOwqrYMnp3p14rxHepDcSWALJKrKGp4immlWPAbejkuzGgoJbsIApu8WEbgv0Z00NwDBA5XT"; // Move this to environment variables

      // Initialize Stripe
      let stripe, elements, card, transferCard;

      try {
        stripe = Stripe(STRIPE_PUBLIC_KEY);
        elements = stripe.elements();

        // Deposit card element
        card = elements.create("card");
        card.mount("#stripe-card-element");

        card.on("change", ({ error }) => {
          const displayError = document.getElementById("card-errors");
          if (error) {
            displayError.textContent = error.message;
          } else {
            displayError.textContent = "";
          }
        });

        // Transfer card element
        transferCard = elements.create("card");
        transferCard.mount("#stripe-transfer-card-element");

        transferCard.on("change", ({ error }) => {
          const displayError = document.getElementById("transfer-card-errors");
          if (error) {
            displayError.textContent = error.message;
          } else {
            displayError.textContent = "";
          }
        });
      } catch (error) {
        console.error("Stripe initialization failed:", error);
        showAlert(
          "Stripe initialization failed. Card payments unavailable.",
          "error"
        );
      }

      // Utility functions
      function showAlert(message, type = "success") {
        const alertsContainer = document.getElementById("alerts");
        const alertDiv = document.createElement("div");
        alertDiv.className = `alert alert-${type} show`;
        alertDiv.innerHTML = `
          ${message}
          <button onclick="this.parentElement.remove()" style="float: right; background: none; border: none; cursor: pointer;">&times;</button>
        `;
        alertsContainer.appendChild(alertDiv);

        // Auto-remove after 5 seconds
        setTimeout(() => {
          alertDiv.remove();
        }, 5000);
      }

      function setLoading(buttonId, spinnerId, isLoading) {
        const button = document.getElementById(buttonId);
        const spinner = document.getElementById(spinnerId);

        if (isLoading) {
          button.disabled = true;
          spinner.style.display = "inline-block";
        } else {
          button.disabled = false;
          spinner.style.display = "none";
        }
      }

      function getAuthToken() {
        // Implement your authentication logic here
        return localStorage.getItem("token") || sessionStorage.getItem("token");
      }

      async function makeAPICall(url, options = {}) {
        const token = getAuthToken();
        const defaultOptions = {
          headers: {
            "Content-Type": "application/json",
            ...(token && { Authorization: `Bearer ${token}` }),
          },
        };

        const response = await fetch(
          `http://localhost:7000/transaction${url}`,
          {
            ...defaultOptions,
            ...options,
            headers: { ...defaultOptions.headers, ...options.headers },
          }
        );

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data.message || `HTTP error! status: ${response.status}`
          );
        }

        return data;
      }

      // Tab functionality
      function showTab(id) {
        const tabs = document.querySelectorAll(".tab");
        const contents = document.querySelectorAll(".tab-content");

        tabs.forEach((tab) => tab.classList.remove("active"));
        contents.forEach((content) => content.classList.remove("active"));

        document.querySelector(`#${id}`).classList.add("active");
        event.currentTarget.classList.add("active");
      }

      function toggleDepositMethod() {
        const method = document.getElementById("depositMethod").value;
        document.getElementById("cashDeposit").style.display =
          method === "cash" ? "block" : "none";
        document.getElementById("stripeDeposit").style.display =
          method === "stripe" ? "block" : "none";
      }

      function toggleTransferMethod() {
        const method = document.getElementById("transferMethod").value;
        document.getElementById("regularTransfer").style.display =
          method === "regular" ? "block" : "none";
        document.getElementById("stripeTransfer").style.display =
          method === "stripe" ? "block" : "none";
      }

      // Cash Deposit
      async function processCashDeposit() {
        const accountNumber = document.getElementById(
          "depositAccountNumber"
        ).value;
        const amount = parseFloat(
          document.getElementById("depositAmount").value
        );
        const description =
          document.getElementById("depositDescription").value || "Cash deposit";

        if (!accountNumber || !amount || amount <= 0) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        setLoading("cashDepositBtn", "cashSpinner", true);

        try {
          const response = await makeAPICall("/deposit", {
            method: "POST",
            body: JSON.stringify({
              accountNumber,
              amount,
              description,
            }),
          });

          showAlert(
            `Cash deposit successful! New balance: $${
              response.account?.newBalance || "N/A"
            }`,
            "success"
          );

          // Reset form
          document.getElementById("depositForm").reset();
        } catch (error) {
          showAlert(`Deposit failed: ${error.message}`, "error");
        } finally {
          setLoading("cashDepositBtn", "cashSpinner", false);
        }
      }

      // Withdraw
      async function processWithdraw() {
        const accountNumber = document.getElementById(
          "withdrawAccountNumber"
        ).value;
        const amount = parseFloat(
          document.getElementById("withdrawAmount").value
        );
        const description =
          document.getElementById("withdrawDescription").value || "Withdrawal";

        if (!accountNumber || !amount || amount <= 0) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        setLoading("withdrawBtn", "withdrawSpinner", true);

        try {
          const response = await makeAPICall("/withdraw", {
            method: "POST",
            body: JSON.stringify({
              accountNumber,
              amount,
              description,
            }),
          });

          showAlert(
            `Withdrawal successful! New balance: $${
              response.account?.newBalance || "N/A"
            }`,
            "success"
          );

          // Reset form
          document.getElementById("withdrawForm").reset();
        } catch (error) {
          showAlert(`Withdrawal failed: ${error.message}`, "error");
        } finally {
          setLoading("withdrawBtn", "withdrawSpinner", false);
        }
      }

      // Regular Transfer
      async function processTransfer() {
        const fromAccountNumber =
          document.getElementById("fromAccountNumber").value;
        const toAccountNumber =
          document.getElementById("toAccountNumber").value;
        const amount = parseFloat(
          document.getElementById("transferAmount").value
        );
        const description =
          document.getElementById("transferDescription").value || "Transfer";

        if (!fromAccountNumber || !toAccountNumber || !amount || amount <= 0) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        if (fromAccountNumber === toAccountNumber) {
          showAlert(
            "Source and destination accounts cannot be the same.",
            "error"
          );
          return;
        }

        setLoading("transferBtn", "transferSpinner", true);

        try {
          const response = await makeAPICall("/transfer", {
            method: "POST",
            body: JSON.stringify({
              fromAccountNumber,
              toAccountNumber,
              amount,
              description,
            }),
          });

          let message = `Transfer successful! `;
          if (response.fromAccount) {
            message += `From account balance: $${response.fromAccount.newBalance} `;
          }
          if (response.tranferFee) {
            message += `(Transfer fee: $${response.tranferFee})`;
          }

          showAlert(message, "success");

          // Reset form
          document.getElementById("transferForm").reset();
        } catch (error) {
          showAlert(`Transfer failed: ${error.message}`, "error");
        } finally {
          setLoading("transferBtn", "transferSpinner", false);
        }
      }

      // Stripe Transfer
      async function processStripeTransfer() {
        const fromAccountNumber =
          document.getElementById("fromAccountNumber").value;
        const toAccountNumber =
          document.getElementById("toAccountNumber").value;
        const amount = parseFloat(
          document.getElementById("transferAmount").value
        );
        const description =
          document.getElementById("transferDescription").value ||
          "Stripe Transfer";
        const transferType =
          document.getElementById("stripeTransferType").value;
        const name = document.getElementById("transferCardholderName").value;
        const email = document.getElementById("transferCardholderEmail").value;
        const phone = document.getElementById("transferCardholderPhone").value;

        if (
          !fromAccountNumber ||
          !toAccountNumber ||
          !amount ||
          amount <= 0 ||
          !name ||
          !email
        ) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        if (fromAccountNumber === toAccountNumber) {
          showAlert(
            "Source and destination accounts cannot be the same.",
            "error"
          );
          return;
        }

        if (!stripe || !transferCard) {
          showAlert(
            "Stripe is not properly initialized. Please refresh the page.",
            "error"
          );
          return;
        }

        setLoading("stripeTransferBtn", "stripeTransferSpinner", true);

        try {
          // Step 1: Create Stripe Payment Method
          const { paymentMethod, error: pmError } =
            await stripe.createPaymentMethod({
              type: "card",
              card: transferCard,
              billing_details: {
                name,
                email,
                phone,
              },
            });

          if (pmError) {
            throw new Error(pmError.message);
          }

          // Step 2: Send transfer request to backend
          const response = await makeAPICall("/stripe/transfer", {
            method: "POST",
            body: JSON.stringify({
              fromAccountNumber,
              toAccountNumber,
              amount,
              description,
              transferType,
              paymentMethodId: paymentMethod.id,
              customerData: {
                name,
                email,
                phone,
              },
            }),
          });

          let message = `Stripe transfer successful! `;
          if (response.data?.fromAccount) {
            message += `From account balance: $${response.data.fromAccount.newBalance} `;
          }
          if (response.data?.transaction?.transferFee) {
            message += `(Transfer fee: $${response.data.transaction.transferFee}) `;
          }
          if (response.data?.externalFundingUsed) {
            message += `External funding was used to complete the transfer.`;
          }

          showAlert(message, "success");

          // Reset form
          document.getElementById("transferForm").reset();
          transferCard.clear();
        } catch (error) {
          const errorMessage = error.message || "Stripe transfer failed";
          document.getElementById("transfer-card-errors").textContent =
            errorMessage;
          showAlert(`Transfer failed: ${errorMessage}`, "error");
        } finally {
          setLoading("stripeTransferBtn", "stripeTransferSpinner", false);
        }
      }

      // Stripe Deposit
      async function processStripeDeposit() {
        const accountNumber = document.getElementById(
          "depositAccountNumber"
        ).value;
        const amount = parseFloat(
          document.getElementById("depositAmount").value
        );
        const description =
          document.getElementById("depositDescription").value ||
          "Stripe deposit";
        const name = document.getElementById("cardholderName").value;
        const email = document.getElementById("cardholderEmail").value;
        const phone = document.getElementById("cardholderPhone").value;

        if (!accountNumber || !amount || amount <= 0 || !name || !email) {
          showAlert(
            "Please fill in all required fields with valid values.",
            "error"
          );
          return;
        }

        if (!stripe || !card) {
          showAlert(
            "Stripe is not properly initialized. Please refresh the page.",
            "error"
          );
          return;
        }

        setLoading("stripeDepositBtn", "stripeSpinner", true);

        try {
          // Step 1: Create Stripe Payment Method
          const { paymentMethod, error: pmError } =
            await stripe.createPaymentMethod({
              type: "card",
              card: card,
              billing_details: {
                name,
                email,
                phone,
              },
            });

          if (pmError) {
            throw new Error(pmError.message);
          }

          // Step 2: Send payment intent request to backend
          const response = await makeAPICall("/stripe/create-payment-intent", {
            method: "POST",
            body: JSON.stringify({
              accountNumber,
              amount,
              description,
              paymentMethodId: paymentMethod.id,
              customerData: {
                name,
                email,
                phone,
              },
              action: "process",
            }),
          });

          if (response.data?.paymentIntent?.status === "succeeded") {
            showAlert(
              `Stripe payment successful! Amount: $${amount}`,
              "success"
            );

            // Reset form
            document.getElementById("depositForm").reset();
            card.clear();
          } else {
            showAlert(
              "Stripe payment is processing. Check your account shortly.",
              "success"
            );
          }
        } catch (error) {
          const errorMessage = error.message || "Stripe payment failed";
          document.getElementById("card-errors").textContent = errorMessage;
          showAlert(`Payment failed: ${errorMessage}`, "error");
        } finally {
          setLoading("stripeDepositBtn", "stripeSpinner", false);
        }
      }

      // Initialize the page
      document.addEventListener("DOMContentLoaded", function () {
        // Set default values or perform initial setup
        console.log("Bank Transactions page loaded");
      });
    </script>
  </body>
</html>
