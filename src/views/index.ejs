<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bank Transactions</title>
    <script src="https://js.stripe.com/v3/"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
    <link href="/src/views/index.css" rel="stylesheet" />
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1><i class="fas fa-university"></i> Bank Transactions</h1>
        <p>Manage your deposits, withdrawals, and transfers securely</p>
      </div>

      <div class="tabs">
        <button class="tab active" onclick="showTab('deposit')">
          <i class="fas fa-plus-circle"></i> Deposit
        </button>
        <button class="tab" onclick="showTab('withdraw')">
          <i class="fas fa-minus-circle"></i> Withdraw
        </button>
        <button class="tab" onclick="showTab('transfer')">
          <i class="fas fa-exchange-alt"></i> Transfer
        </button>
        <button class="tab" onclick="showTab('history')">
          <i class="fas fa-history"></i> History
        </button>
      </div>

      <div class="content">
        <div id="alerts"></div>

        <!-- Demo Notice -->
        <div class="demo-notice">
          <strong><i class="fas fa-info-circle"></i> Demo Mode</strong>
          This is a demo implementation. Use test card number 4242 4242 4242
          4242 for testing Stripe payments.
        </div>

        <!-- Deposit Tab -->
        <div id="deposit" class="tab-content active">
          <h2><i class="fas fa-plus-circle"></i> Deposit Funds</h2>

          <form id="depositForm">
            <div class="row">
              <div class="form-group">
                <label>Account Number</label>
                <input
                  type="text"
                  id="depositAccountNumber"
                  class="form-control"
                  placeholder="Enter account number"
                  required
                />
              </div>
              <div class="form-group">
                <label>Amount ($)</label>
                <input
                  type="number"
                  id="depositAmount"
                  class="form-control"
                  step="0.01"
                  min="1"
                  placeholder="0.00"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="depositDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <div class="form-group">
              <label>Deposit Method</label>
              <select
                id="depositMethod"
                class="form-control"
                onchange="toggleDepositMethod()"
              >
                <option value="cash">Cash/Check Deposit</option>
                <option value="stripe">Credit/Debit Card (Stripe)</option>
              </select>
            </div>

            <!-- Cash Deposit -->
            <div id="cashDeposit">
              <button
                type="button"
                class="btn btn-success"
                onclick="processCashDeposit()"
                id="cashDepositBtn"
              >
                <i class="fas fa-money-bill-wave"></i>
                <span>Process Cash Deposit</span>
                <div class="spinner" id="cashSpinner"></div>
              </button>
            </div>

            <!-- Stripe Deposit -->
            <div id="stripeDeposit" style="display: none">
              <div class="stripe-form">
                <h3><i class="fab fa-stripe"></i> Card Payment Details</h3>

                <div class="row">
                  <div class="form-group">
                    <label>Cardholder Name</label>
                    <input
                      type="text"
                      id="cardholderName"
                      class="form-control"
                      placeholder="John Doe"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <label>Email</label>
                    <input
                      type="email"
                      id="cardholderEmail"
                      class="form-control"
                      placeholder="john@example.com"
                      required
                    />
                  </div>
                </div>

                <div class="form-group">
                  <label>Phone (Optional)</label>
                  <input
                    type="tel"
                    id="cardholderPhone"
                    class="form-control"
                    placeholder="+1 (555) 123-4567"
                  />
                </div>

                <button
                  type="button"
                  class="btn btn-primary"
                  onclick="showStripeModal()"
                  id="stripeDepositBtn"
                >
                  <i class="fab fa-stripe-s"></i>
                  <span>Pay with Stripe</span>
                  <div class="spinner" id="stripeSpinner"></div>
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- Withdraw Tab -->
        <div id="withdraw" class="tab-content">
          <h2><i class="fas fa-minus-circle"></i> Withdraw Funds</h2>

          <form id="withdrawForm">
            <div class="row">
              <div class="form-group">
                <label>Account Number</label>
                <input
                  type="text"
                  id="withdrawAccountNumber"
                  class="form-control"
                  placeholder="Enter account number"
                  required
                />
              </div>
              <div class="form-group">
                <label>Amount ($)</label>
                <input
                  type="number"
                  id="withdrawAmount"
                  class="form-control"
                  step="0.01"
                  min="1"
                  placeholder="0.00"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="withdrawDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <button
              type="button"
              class="btn btn-warning"
              onclick="processWithdraw()"
              id="withdrawBtn"
            >
              <i class="fas fa-money-bill-wave"></i>
              <span>Process Withdrawal</span>
              <div class="spinner" id="withdrawSpinner"></div>
            </button>
          </form>
        </div>

        <!-- Transfer Tab -->
        <div id="transfer" class="tab-content">
          <h2><i class="fas fa-exchange-alt"></i> Transfer Funds</h2>

          <form id="transferForm">
            <div class="row">
              <div class="form-group">
                <label>From Account Number</label>
                <input
                  type="text"
                  id="fromAccountNumber"
                  class="form-control"
                  placeholder="Source account"
                  required
                />
              </div>
              <div class="form-group">
                <label>To Account Number</label>
                <input
                  type="text"
                  id="toAccountNumber"
                  class="form-control"
                  placeholder="Destination account"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label>Amount ($)</label>
              <input
                type="number"
                id="transferAmount"
                class="form-control"
                step="0.01"
                min="1"
                placeholder="0.00"
                required
              />
            </div>

            <div class="form-group">
              <label>Description</label>
              <input
                type="text"
                id="transferDescription"
                class="form-control"
                placeholder="Optional description"
              />
            </div>

            <button
              type="button"
              class="btn btn-primary"
              onclick="processTransfer()"
              id="transferBtn"
            >
              <i class="fas fa-exchange-alt"></i>
              <span>Process Transfer</span>
              <div class="spinner" id="transferSpinner"></div>
            </button>
          </form>
        </div>

        <!-- History Tab -->
        <div id="history" class="tab-content">
          <h2><i class="fas fa-history"></i> Transaction History</h2>

          <div class="transaction-list" id="transactionList">
            <!-- Sample transactions for demo -->
            <div class="transaction-item">
              <div>
                <strong>Deposit</strong> - $500.00
                <br />
                <small>2024-01-15 10:30 AM</small>
                <br />
                Stripe payment deposit
              </div>
              <span class="transaction-type type-deposit">Deposit</span>
            </div>

            <div class="transaction-item">
              <div>
                <strong>Withdrawal</strong> - $100.00
                <br />
                <small>2024-01-14 02:15 PM</small>
                <br />
                ATM withdrawal
              </div>
              <span class="transaction-type type-withdrawal">Withdrawal</span>
            </div>

            <div class="transaction-item">
              <div>
                <strong>Transfer</strong> - $250.00
                <br />
                <small>2024-01-13 09:45 AM</small>
                <br />
                Transfer to savings account
              </div>
              <span class="transaction-type type-transfer">Transfer</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stripe Payment Modal -->
    <div class="stripe-modal" id="stripeModal">
      <div class="stripe-modal-content">
        <button class="stripe-modal-close" onclick="closeStripeModal()">
          &times;
        </button>
        <h2><i class="fab fa-stripe"></i> Complete Payment</h2>

        <div class="payment-summary" id="paymentSummary">
          <h3>Payment Summary</h3>
          <div class="payment-details">
            <span>Account:</span>
            <span id="summaryAccount">-</span>
          </div>
          <div class="payment-details">
            <span>Description:</span>
            <span id="summaryDescription">-</span>
          </div>
          <div class="payment-details">
            <span>Total Amount:</span>
            <span id="summaryAmount">$0.00</span>
          </div>
        </div>

        <div class="stripe-modal-body">
          <div id="stripe-payment-element"></div>

          <button
            id="stripe-submit-button"
            class="btn btn-primary"
            onclick="handleStripePayment()"
            style="width: 100%"
          >
            <i class="fas fa-lock"></i>
            <span>Pay Now</span>
            <div class="spinner" id="stripeModalSpinner"></div>
          </button>

          <div class="stripe-secure-badge">
            <i class="fas fa-shield-alt"></i>
            <span>Secured by Stripe</span>
          </div>

          <div id="stripe-payment-message" style="display: none"></div>
        </div>
      </div>
    </div>

    <script src="/src/views/script.js"></script>
  </body>
</html>
